# ============================================
# 开发环境配置
# ============================================

NUXT_PUBLIC_SITE_NAME=非乐鱼导航
NUXT_PUBLIC_SITE_URL=http://localhost:8991
NUXT_PUBLIC_ICP=闽ICP备2026014482号

NUXT_DEV_HOST=127.0.0.1
NUXT_DEV_PORT=8991

# 数据库配置 - 开发环境
NUXT_MYSQL_HOST=127.0.0.1
NUXT_MYSQL_PORT=3306
NUXT_MYSQL_USER=your_mysql_user
NUXT_MYSQL_PASSWORD=your_mysql_password
NUXT_MYSQL_DATABASE=your_database_name


# ============================================
# 生产环境配置 (Docker 部署)
# ============================================

NUXT_PUBLIC_SITE_NAME=非乐鱼导航
NUXT_PUBLIC_SITE_URL=https://your-domain.com
NUXT_PUBLIC_ICP=闽ICP备2026014482号

NUXT_DEV_HOST=0.0.0.0
NUXT_DEV_PORT=8991

# 数据库配置 - Docker 内部网络
# mysql 是 docker-compose 中 MySQL 服务的名称
NUXT_MYSQL_HOST=mysql
NUXT_MYSQL_PORT=3306
NUXT_MYSQL_USER=your_mysql_user
NUXT_MYSQL_PASSWORD=your_mysql_password
NUXT_MYSQL_DATABASE=your_database_name


# ============================================
# 生产环境配置 (独立服务器部署)
# ============================================

NUXT_PUBLIC_SITE_NAME=非乐鱼导航
NUXT_PUBLIC_SITE_URL=https://your-domain.com
NUXT_PUBLIC_ICP=闽ICP备2026014482号

NUXT_MYSQL_HOST=127.0.0.1
NUXT_MYSQL_PORT=3306
NUXT_MYSQL_USER=your_mysql_user
NUXT_MYSQL_PASSWORD=your_mysql_password
NUXT_MYSQL_DATABASE=your_database_name